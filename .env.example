# File này dành cho việc chạy `dotnet run` TRỰC TIẾP trên máy (không qua Docker).
#
#   cp .env.example .env
#
# ⚠ Chạy bằng Docker Compose thì dùng file khác: `cp docker/.env.example docker/.env`.
#   `docker compose -f docker/docker-compose.yml` chỉ đọc `.env` NẰM CẠNH file compose,
#   không đọc file này. Xem CONTRIBUTING.md mục 7.

# --- Database ---
POSTGRES_PASSWORD=Dev_Password123!

# --- AI provider ---
# OpenAI | Fake
# Dev mặc định là "Fake" để không tốn tiền. Đổi sang "OpenAI" khi test integration.
AI_PROVIDER=Fake
OPENAI_API_KEY=

# --- JWT ---
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ISSUER=ats-recruitment
JWT_AUDIENCE=ats-recruitment-users

# --- SMTP ---
# Chạy MailHog riêng:  docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ats.local
