# File này dành cho việc chạy `dotnet run` TRỰC TIẾP trên máy (không qua Docker).
#
#   cp .env.example .env
#
# ⚠ Chạy bằng Docker Compose thì dùng file khác: `cp docker/.env.example docker/.env`.
#   `docker compose -f docker/docker-compose.yml` chỉ đọc `.env` NẰM CẠNH file compose,
#   không đọc file này. Xem CONTRIBUTING.md mục 7.

# --- Database ---
POSTGRES_PASSWORD=Dev_Password123!

# --- AI provider ---
# OpenAI | Fake
# Dev mặc định là "Fake" để không tốn tiền. Đổi sang "OpenAI" khi test integration.
AI_PROVIDER=Fake
OPENAI_API_KEY=

# --- JWT ---
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ISSUER=ats-recruitment
JWT_AUDIENCE=ats-recruitment-users

# --- SMTP ---
# Chạy MailHog riêng:  docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ats.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false

# --- AI (api và worker phải giống nhau) ---
OPENAI_MODEL=gpt-4o-mini
AI_PREVIEW_LIMIT_PER_DAY=20
AI_BATCH_LIMIT_PER_DAY=5

# --- Database / seed (chỉ api) ---
DB_AUTO_MIGRATE=true
DB_SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@ats.local
SEED_ADMIN_PASSWORD=Admin@123

# --- Web ---
# Link trong email "quên mật khẩu": {Web:BaseUrl}/reset-password?token=...
WEB_BASE_URL=http://localhost:8081

# Lưu ý: `dotnet run` KHÔNG tự đọc file này. Khoá cấu hình .NET tương ứng (biến môi trường
# hoặc appsettings): AiProvider, OpenAI__ApiKey, OpenAI__Model, Ai__PreviewLimitPerDay,
# Ai__BatchLimitPerDay, Smtp__Host/Port/From/User/Password/EnableSsl, Web__BaseUrl,
# Database__AutoMigrate, Database__SeedDemoData, Seed__AdminEmail, Seed__AdminPassword.
