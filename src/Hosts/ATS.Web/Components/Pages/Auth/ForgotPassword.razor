@page "/forgot-password"
@inject AuthApi Auth

<PageTitle>Quên mật khẩu · ATS</PageTitle>

<section class="auth-card">
    <h1>Quên mật khẩu</h1>

    @if (_sent)
    {
        @* LUON cung mot cau, du email co ton tai hay khong (UC-06) — khong cho do tai khoan. *@
        <div class="alert alert-info" role="status">
            Nếu email này đã đăng ký, chúng tôi đã gửi link đặt lại mật khẩu. Link có hiệu lực 30 phút.
        </div>
        <a href="login">Về trang đăng nhập</a>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="forgot">
            <DataAnnotationsValidator />
            <label>
                Email đã đăng ký
                <InputText @bind-Value="_form.Email" type="email" autocomplete="email" />
                <ValidationMessage For="() => _form.Email" />
            </label>

            <ErrorAlert Message="@_error" />

            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @if (_busy)
                {
                    <Spinner />
                }
                Gửi link đặt lại
            </button>
        </EditForm>
    }
</section>

@code {
    private readonly ForgotPasswordForm _form = new();
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var result = await Auth.ForgotPasswordAsync(_form.Email.Trim());
        _busy = false;

        // Chi bao loi khi KHONG goi duoc API (mat ket noi, 5xx); moi phan hoi 2xx/4xx deu hien cung mot cau.
        if (!result.IsSuccess && (result.StatusCode == 0 || result.StatusCode >= 500))
        {
            _error = result.Error;
            return;
        }

        _sent = true;
    }
}
