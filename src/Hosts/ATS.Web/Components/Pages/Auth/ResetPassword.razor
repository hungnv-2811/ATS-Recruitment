@page "/reset-password"
@inject AuthApi Auth

<PageTitle>Đặt lại mật khẩu · ATS</PageTitle>

<section class="auth-card">
    <h1>Đặt lại mật khẩu</h1>

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <ErrorAlert Message="Link đặt lại mật khẩu không hợp lệ. Hãy mở đúng link trong email." />
        <a href="forgot-password">Gửi lại link</a>
    }
    else if (_done)
    {
        <div class="alert alert-success" role="status">Đã đổi mật khẩu. Bạn có thể đăng nhập bằng mật khẩu mới.</div>
        <a class="btn btn-primary" href="login">Đăng nhập</a>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="reset">
            <DataAnnotationsValidator />
            <label>
                Mật khẩu mới
                <InputText @bind-Value="_form.NewPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.NewPassword" />
            </label>
            <label>
                Nhập lại mật khẩu mới
                <InputText @bind-Value="_form.ConfirmPassword" type="password" autocomplete="new-password" />
                <ValidationMessage For="() => _form.ConfirmPassword" />
            </label>

            <ErrorAlert Message="@_error" />

            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @if (_busy)
                {
                    <Spinner />
                }
                Đổi mật khẩu
            </button>
        </EditForm>
    }
</section>

@code {
    private readonly ResetPasswordForm _form = new();
    private bool _busy;
    private bool _done;
    private string? _error;

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var result = await Auth.ResetPasswordAsync(Token!, _form.NewPassword);
        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.StatusCode == 400
                ? "Link đã hết hạn hoặc đã được dùng. Hãy yêu cầu link mới."
                : result.Error;
            return;
        }

        _done = true;
    }
}
