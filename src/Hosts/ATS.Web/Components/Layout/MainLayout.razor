@inherits LayoutComponentBase

<div class="page">
    <header class="topbar">
        <a class="brand" href=""><span class="brand-mark" aria-hidden="true">A</span>ATS Recruitment</a>
        <NavMenu />
    </header>

    <main class="content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="alert alert-error" role="alert">
                    Đã có lỗi khi hiển thị trang này.
                    <button type="button" class="link-button" @onclick="Recover">Thử lại</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();
}
