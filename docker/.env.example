# Sao chép thành .env rồi điền giá trị thật. File .env KHÔNG được commit.
#   cp docker/.env.example docker/.env

# --- Cổng phía host ---
# Chỉ đổi khi máy bạn đã chạy sẵn thứ khác ở cổng đó. Đổi ở ĐÂY, đừng sửa
# docker-compose.yml — sửa file đó là cả nhóm phải sửa theo.
# Kiểm tra cổng nào đang bận:  docker ps  /  netstat -ano | findstr :8080
API_PORT=8080
WEB_PORT=8081
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
DB_PORT=5432
REDIS_PORT=6379

# Mật khẩu PostgreSQL (dùng chung cho db, api và worker)
POSTGRES_PASSWORD=Dev_Password123!

# Khoá LLM — CẢ `worker` LẪN `api` đều cần.
#   worker : sàng lọc lô (bất đồng bộ, ADR-2)
#   api    : preview 1 CV cho ứng viên (đồng bộ, ngoại lệ có chủ đích của ADR-2 — xem UC-05)
# Để trống cũng chạy được: pipeline rơi xuống KeywordScoringAdapter.
OPENAI_API_KEY=sk-...

# Adapter AI đang bật: OpenAI | Fake
# Xem docs/architecture.md — ADR-3. Đổi giá trị này là đổi nhà cung cấp,
# không phải sửa code nghiệp vụ.
#
# ⚠ Biến này áp dụng cho CẢ api VÀ worker. Đặt lệch nhau thì ứng viên nhận điểm giả
#   trong khi HR nhận điểm thật — hai bên nhìn hai con số khác nhau cho cùng một hồ sơ.
AI_PROVIDER=OpenAI

# --- JWT (api dùng để ký token đăng nhập) ---
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ISSUER=ats-recruitment
JWT_AUDIENCE=ats-recruitment-users

# --- SMTP ---
# Dev: để nguyên, mail đi vào container MailHog, xem ở http://localhost:8025
# Không có mail nào gửi ra Internet.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@ats.local
