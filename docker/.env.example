# Sao chép thành .env rồi điền giá trị thật. File .env KHÔNG được commit.
#   cp docker/.env.example docker/.env

# Mật khẩu PostgreSQL (dùng chung cho db, api và worker)
POSTGRES_PASSWORD=Dev_Password123!

# Khoá LLM — chỉ container `worker` dùng, API không bao giờ gọi thẳng LLM.
OPENAI_API_KEY=sk-...

# Adapter AI đang bật: OpenAI | AzureOpenAI | LocalModel | EmbeddingOnly | Fake
# Xem docs/architecture.md — ADR-03. Đổi giá trị này là đổi nhà cung cấp,
# không phải sửa code nghiệp vụ.
AI_PROVIDER=OpenAI
